# MatrixMedia self-host — non-secret configuration.
#
# install.sh writes a real .env for you from its CLI flags; this file documents
# every knob and its default. Secrets are NOT here — they are generated once into
# .env.secrets by lib/secrets.sh and never rotate. Never commit a populated .env
# or .env.secrets.

# --- required ---------------------------------------------------------------
# Apex domain you own. Synapse server_name + all routing derive from this.
# Federation/well-known is served at the apex; services live at matrix.${MM_DOMAIN}.
MM_DOMAIN=example.com

# Public IPv4 of this host (coturn external-ip, livekit node_ip, mm-switch).
# install.sh auto-detects this in preflight; override only if detection is wrong.
MM_PUBLIC_IP=203.0.113.10

# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# --- images -----------------------------------------------------------------
# Container registry + tags. Defaults pull the published MatrixMedia images.
MM_REGISTRY=ghcr.io/matrixmedia
MM_VERSION=0.8.1
MM_SWITCH_VERSION=0.5.12

# --- TLS --------------------------------------------------------------------
# Set automatically by install.sh: "dns01" when a --dns-token is supplied
# (wildcard certs), else "http01". You normally do not set this by hand.
MM_TLS_MODE=http01

# --- payments ---------------------------------------------------------------
# Demo mode wires the in-stack mm-fakestripe + mock Lightning so the full
# monetization UI works with NO real money. NEVER set true on a real-money host.
MM_DEMO_MODE=false
MM_ALLOW_MOCK=false

# Stripe API base. Demo points at the fakestripe sidecar; real money uses Stripe.
MM_STRIPE_API_BASE=https://api.stripe.com/
# Real Stripe credentials (leave blank in demo mode).
MM_STRIPE_SECRET_KEY=
MM_STRIPE_WEBHOOK_SECRET=
