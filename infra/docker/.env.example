# =============================================================================
# MatrixMedia Development Environment
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables use the MM_ prefix.
# Secrets support the _FROM_FILE suffix (e.g. MM_JWT_SIGNING_KEY_FROM_FILE).
# =============================================================================

# -- Database -----------------------------------------------------------------
# SQLite (default, zero-dependency):
MM_DATABASE_URL=sqlite://data/matrixmedia.db?mode=rwc
# PostgreSQL (uncomment for larger deployments):
# MM_DATABASE_URL=postgres://mm:mm_dev@localhost:5432/matrixmedia?sslmode=disable

# -- Matrix integration -------------------------------------------------------
MM_MATRIX_HOMESERVER_URL=http://synapse:8008
MM_MATRIX_SERVER_NAME=localhost
MM_MATRIX_AS_TOKEN=mm-dev-as-token-change-in-prod
MM_MATRIX_HS_TOKEN=mm-dev-hs-token-change-in-prod
MM_MATRIX_BOT_LOCALPART=mmbot

# -- SFU (LiveKit) ------------------------------------------------------------
MM_SFU_ADAPTER=livekit
MM_SFU_LIVEKIT_URL=ws://livekit:7880
MM_SFU_LIVEKIT_API_KEY=devkey
MM_SFU_LIVEKIT_API_SECRET=devsecret

# -- Server ports -------------------------------------------------------------
MM_SERVER_LISTEN_PORT=6167
MM_ADMIN_LISTEN_PORT=6168
MM_METRICS_PORT=9090

# -- Media storage ------------------------------------------------------------
# Local filesystem (default for dev):
MM_STORAGE_BACKEND=local
MM_STORAGE_LOCAL_PATH=./data/media

# S3 / MinIO (uncomment for S3-compatible testing):
# MM_STORAGE_BACKEND=s3
# MM_STORAGE_S3_ENDPOINT=http://minio:9000
# MM_STORAGE_S3_BUCKET=matrixmedia
# MM_STORAGE_S3_REGION=us-east-1
# MM_STORAGE_S3_ACCESS_KEY=mm_storage
# MM_STORAGE_S3_SECRET_KEY=mm_storage_dev
# MM_STORAGE_S3_PATH_STYLE=true

# -- Auth & security ----------------------------------------------------------
MM_JWT_SIGNING_KEY=dev-signing-key-must-be-at-least-32-bytes!!
MM_ADMIN_TOKEN=dev-admin-token-change-in-prod

# -- Widget static files ------------------------------------------------------
# Uncomment to serve the built widget at /_mm/widget/
# MM_WIDGET_DIR=../../web/packages/mm-widget/dist

# -- Logging ------------------------------------------------------------------
MM_LOG_LEVEL=info

# -- Monetization (Phase 7a+) ------------------------------------------------
# Master toggle -- set to "true" to enable donation features
MM_MONETIZATION_ENABLED=false
MM_MONETIZATION_DONATIONS_ENABLED=false

# PostgreSQL (required when monetization enabled)
MM_POSTGRES_URL=postgres://matrixmedia:mm_dev_password@postgres:5432/matrixmedia
MM_POSTGRES_PASSWORD=mm_dev_password

# Stripe Connect (required when monetization enabled)
# Get test keys from https://dashboard.stripe.com/test/apikeys
MM_STRIPE_SECRET_KEY=sk_test_REPLACE_ME
MM_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
MM_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Platform fee (0.0 = self-hosted, 0.10 = 10% managed)
MM_MONETIZATION_PLATFORM_FEE_PCT=0.10

# -- Redis (optional shared cache) -------------------------------------------
# When set, enables L2 Redis cache for entitlements, rate limiting, trending.
# When empty/unset, falls back to in-process moka cache.
MM_REDIS_URL=redis://redis:6379
