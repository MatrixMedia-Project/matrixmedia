{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrixmedia.dev/schemas/events/dev.matrixmedia.feed.broadcast.ended.json",
  "title": "dev.matrixmedia.feed.broadcast.ended",
  "description": "Timeline event the server's bot sends when a live broadcast ends. Payload profile v1, identical to the legacy com.steegler.matrixmedia.feed.broadcast.ended (ADR-0011); readers accept both names.",
  "type": "object",
  "required": [
    "version",
    "body",
    "msgtype",
    "stream_id",
    "ended_at",
    "duration_ms"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version."
    },
    "body": {
      "type": "string",
      "description": "Human-readable fallback (\"<host>'s broadcast ended\"); shipped apps match \"broadcast ended\"."
    },
    "msgtype": {
      "type": "string",
      "const": "m.notice",
      "description": "Fallback msgtype so non-MatrixMedia clients render the event as a notice."
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "pattern": "^@[^:]+:.+$"
    },
    "ended_at": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "m.relates_to": {
      "type": "object",
      "required": [
        "rel_type",
        "event_id"
      ],
      "properties": {
        "rel_type": {
          "type": "string",
          "const": "m.reference"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Reference to the broadcast.started event of the same stream, when its id was stored."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "version": 1,
      "body": "@alice:example.org's broadcast ended",
      "msgtype": "m.notice",
      "stream_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "host": "@alice:example.org",
      "ended_at": 1765000360000,
      "duration_ms": 360000,
      "m.relates_to": {
        "rel_type": "m.reference",
        "event_id": "$started:example.org"
      }
    }
  ]
}
