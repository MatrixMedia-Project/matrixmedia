# MatrixMedia — pinned image versions for a reproducible self-host install.
#
# WHY: the compose stack previously pulled TEN third-party images on `:latest`.
# Two installs a week apart could therefore run different Synapse/LiveKit/Traefik
# builds, which makes "works on my machine" unfalsifiable and upgrades
# un-rollback-able. Every image the stack pulls is pinned here.
#
# This file is sourced by install.sh / mmctl before `docker compose`. Override any
# single value in .env to deviate.
#
# EVERY TAG BELOW WAS VERIFIED TO EXIST with `docker manifest inspect` on
# 2026-10-19 (plus the upstream release APIs for newest-stable selection).
# Do not hand-edit without re-verifying — a non-existent tag fails the
# whole install at pull time. (Two of the first-guess pins, livekit/egress:v1.9.2
# and lnbitsdocker/lnbits:0.12.12, did NOT exist; that's why this check matters.)
#
# Cutover NEW box (Docker 29, clean /opt/mm): these are the newest stable
# upstream tags the stack supports as of 2026-10-19. First-party images are
# BUILT natively from the development branch on NEW (deploy/docs/native-build.md),
# never save/load-transferred; third-party images pull at these pins.

# ── First-party (built by .github/workflows/build-images.yml on v* tags) ──────
MM_REGISTRY=ghcr.io/matrixmedia-project
MM_VERSION=0.9.4
MM_SWITCH_VERSION=0.5.4
# mm-web bakes the dashboard + viewer SPAs. Before it existed, a fresh install
# served a 404 UI from an unpopulated bind-mount while smoke still passed.
MM_WEB_IMAGE=ghcr.io/matrixmedia-project/matrixmedia-mm-web:0.9.4
# Demo-mode payments (MM_DEMO_MODE=true). Not needed for a real-money install.
MM_FAKESTRIPE_IMAGE=ghcr.io/matrixmedia-project/matrixmedia-mm-fakestripe:0.2.1

# ── Matrix ───────────────────────────────────────────────────────────────────
# Newest stable v1.x (GitHub element-hq/synapse release v1.163.0, 2026-10-14).
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.163.0

# ── Data ─────────────────────────────────────────────────────────────────────
# Postgres 18 / Redis 8 are the current stable majors (fresh volumes on NEW, so
# no major-version upgrade path is needed).
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# ── Edge ─────────────────────────────────────────────────────────────────────
# Traefik v3.7 (GitHub traefik/traefik release v3.7.15, 2026-10-15); same v3
# syntax as the v3.5 file config + labels, so no router changes needed.
# coturn 4.18.0 (GitHub coturn/coturn release, 2026-09-08); --lt-cred-mech and
# the static --user flags the compose file uses are unchanged.
TRAEFIK_IMAGE=traefik:v3.7
COTURN_IMAGE=coturn/coturn:4.18.0

# ── Realtime / calls ─────────────────────────────────────────────────────────
# Newest stable minors; ingress v1.5.0 was already the newest. Element Call
# v0.28.0 (GitHub element-hq/element-call release, 2026-10-13) against
# LiveKit server v1.13.x is the contemporary supported pairing.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.10
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.15.0
LIVEKIT_INGRESS_IMAGE=livekit/ingress:v1.5.0
ELEMENT_CALL_IMAGE=ghcr.io/element-hq/element-call:v0.28.0
# Upstream publishes no semver tag for this service; latest-ci is the documented
# consumable tag. Revisit if element-hq starts tagging releases.
LK_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:latest-ci

# ── Lightning (demo profile only; pulled only when MM_DEMO_MODE=true) ─────────
# The maintained image repo is lnbits/lnbits (semver tags). lnbitsdocker/lnbits
# is abandoned (last push 2021) — do not go back to it.
LNBITS_IMAGE=lnbits/lnbits:v1.6.2
