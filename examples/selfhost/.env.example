# MatrixMedia self-host — example environment.
# Copy to .env and fill in. Generate secrets with e.g. `openssl rand -hex 32`.

# Your apex domain (Synapse server_name; services live at matrix.${MM_DOMAIN}).
MM_DOMAIN=example.com
# Public IPv4 of this host (used by the SFU / media relay).
MM_PUBLIC_IP=203.0.113.10

# Container images (defaults pull the published MatrixMedia images).
MM_REGISTRY=ghcr.io/matrixmedia
MM_VERSION=latest
MM_SWITCH_VERSION=latest

# --- secrets (generate strong random values) ---
POSTGRES_PASSWORD=
MM_JWT_SIGNING_KEY=
MM_ADMIN_TOKEN=
MM_SWITCH_AUTH_SECRET=
# Matrix appservice tokens — must match your registration .yaml + homeserver.yaml
MM_AS_TOKEN=
MM_HS_TOKEN=
# LiveKit credentials — must match your livekit.yaml keys block
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: enable monetization (then configure Stripe/Lightning per the docs).
MM_MONETIZATION_ENABLED=false
