{
  "name": "@matrixmedia/widget",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/mm-stream.umd.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "unpkg": "./dist-lib/mm-stream.umd.js",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/mm-stream.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@matrixmedia/client": "*",
    "hls.js": "^1.6.15",
    "livekit-client": "^2.18.1",
    "solid-element": "^1.9.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^2.0.0"
  }
}
