# Thin runtime image — assumes mm-server is built locally via cargo zigbuild
# (per the project rule: build all binaries locally, never inside the Mac
# Docker emulator). Build with:
#
#   cargo zigbuild --release --target x86_64-unknown-linux-gnu --bin mm-server
#   docker buildx build --platform linux/amd64 \
#     -f infra/docker/Dockerfile.prebuilt \
#     -t argiad/mm-core:VERSION --load .
#
# Build context is the workspace root; the only file pulled in is the
# pre-built binary at target/x86_64-unknown-linux-gnu/release/mm-server.

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

COPY target/x86_64-unknown-linux-gnu/release/mm-server /usr/local/bin/matrixmedia

RUN adduser --system --no-create-home --group matrixmedia && \
    mkdir -p /data /etc/matrixmedia && \
    chown matrixmedia:matrixmedia /data /etc/matrixmedia

USER matrixmedia
VOLUME ["/data", "/etc/matrixmedia"]
EXPOSE 6167 6168 9090
ENTRYPOINT ["matrixmedia"]
CMD ["serve"]
