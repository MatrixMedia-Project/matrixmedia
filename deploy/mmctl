#!/usr/bin/env bash
set -euo pipefail
MM_ROOT="${MM_ROOT:-/opt/mm}"
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1090
for f in common secrets render up smoke backup bootstrap rotate lifecycle; do source "$HERE/lib/$f.sh"; done
compose_env_files
DC=(docker compose "${MM_ENV_FILES[@]}" -f "$MM_ROOT/docker-compose.yml" -p matrixmedia)

usage() {
  cat >&2 <<'USAGE'
usage: mmctl <command>

  run           status | start | stop | restart [svc] | logs [svc]
  day-2         check | backup | upgrade | restore [archive] | secrets
  maintenance   rotate <secret> [--dry-run] | renew-certs | init | version
  teardown      uninstall [--purge]

  check       health report; changes nothing
  upgrade     BACKS UP FIRST, then pulls + rolls + smokes. Aborts if the backup fails.
  restore     roll back to a backup. The DB rolls FORWARD ONLY — this is the only way back.
  uninstall   stops the stack, KEEPS data. --purge destroys the data volumes forever.
USAGE
  exit 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  status)   "${DC[@]}" ps ;;
  start)    "${DC[@]}" up -d ;;
  stop)     "${DC[@]}" down ;;
  restart)  "${DC[@]}" restart "$@" ;;
  logs)     "${DC[@]}" logs --tail=200 "$@" ;;
  update)   "${DC[@]}" pull && "${DC[@]}" up -d ;;
  backup)   backup ;;
  rotate)   rotate_cmd "$@" ;;
  init)      mm_init ;;
  check)     mm_check ;;
  upgrade)   mm_upgrade ;;
  restore)   mm_restore "$@" ;;
  uninstall) mm_uninstall "$@" ;;
  secrets)   mm_secrets ;;
  doctor)
    # shellcheck disable=SC1091
    source "$MM_ROOT/.env"; source "$MM_ROOT/.env.secrets"
    MM_TEMP_MODE="$(grep -s '^MM_TEMP_MODE=' "$MM_ROOT/.env" | cut -d= -f2)"; export MM_TEMP_MODE
    self_smoke "$MM_DOMAIN" "${MM_SYNAPSE_ADMIN_TOKEN:-${MM_ADMIN_TOKEN:-}}" ;;
  renew-certs) "${DC[@]}" restart traefik ;;
  version)  echo "mmctl $(git -C "$HERE/.." rev-parse --short HEAD 2>/dev/null || echo dev)" ;;
  *) usage ;;
esac
